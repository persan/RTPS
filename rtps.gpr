------------------------------------------------------------------------------
--  rtps.gpr -- library project for the RTPS 2.2 protocol implementation
--
--  Library features (Library_Name/Library_Dir/Library_Kind) are only
--  enabled for local Windows builds with GNAT Pro; the CI uses Alire's
--  gnat_native toolchain where the static-library prologue is handled
--  by Alire itself, so the plain-object build works everywhere.
------------------------------------------------------------------------------

library project Rtps is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";

   for Library_Name use "RTPS";
   for Library_Kind use "Static";

   package Compiler is
      for Switches ("ada") use ("-gnat2022", "-gnatwa", "-gnatVa");
   end Compiler;

end Rtps;