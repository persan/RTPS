------------------------------------------------------------------------------
--  test_rtps.gpr -- AUnit test-driver project importing the RTPS library
------------------------------------------------------------------------------

with "../rtps.gpr";
with "aunit";

project Test_RTPS is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("test_rtps.adb");

   package Compiler is
      for Switches ("ada") use ("-gnat2022", "-gnatwa");
   end Compiler;

end Test_RTPS;